---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page introuvable | Meenerva">
	<main class="min-h-screen flex flex-col items-center justify-center px-6 text-center bg-zinc-950 text-zinc-100">
		<p class="text-7xl md:text-9xl font-black text-purple-500/40">404</p>
		<h1 class="mt-2 text-3xl md:text-4xl font-bold tracking-tight">Page introuvable</h1>
		<p class="mt-4 max-w-md text-zinc-400 text-lg">
			Cette page n'existe pas ou a été déplacée.
		</p>
		<a
			href="/"
			class="mt-8 inline-flex items-center rounded-full bg-white/10 px-6 py-3 text-sm font-medium text-white ring-1 ring-white/15 transition hover:bg-white/20"
		>
			Retour à l'accueil
		</a>
	</main>
</Layout>
